# ── Secrets ─────────────────────────────────────────────
# Git history is permanent. Nothing sensitive, ever.
.env
.env.*
!.env.example
*.pem
*.key

# ── Dependencies ────────────────────────────────────────
node_modules/

# ── Build output ────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Local runtime state ─────────────────────────────────
# SQLite plus its WAL sidecars. Recreated on first run.
# Committed datasets live in data/ and are NOT ignored.
.data/
*.db
*.db-wal
*.db-shm

# ── Editors / OS ────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────────────────
*.log
npm-debug.log*
