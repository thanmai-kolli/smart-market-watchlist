# Every value below has a working default — this file is documentation, not a
# requirement. The app runs with no .env at all.

# --- api ---
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=.data/watchlist.db

# How long a fetched quote stays usable. Short while trading, long once shut.
CACHE_TTL_OPEN_MS=30000
CACHE_TTL_CLOSED_MS=900000

# A symbol that has not traded in this long is stale, even with the market open.
STALE_AFTER_MS=900000

# Benchmark that beta is measured against.
BENCHMARK=^NSEI

# How many cards the briefing may show, and how unusual a move must be to earn one.
# Run `npm run calibrate -w api` to see the firing rate for a given threshold.
CARD_BUDGET=3
Z_THRESHOLD=2.0

# --- web ---
VITE_API_URL=http://localhost:3001
